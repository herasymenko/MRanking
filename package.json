{
  "name": "mranking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vinext build && tsc --noEmit && node --test tests/rendered-html.test.mjs tests/wheel-and-localization.test.mjs tests/wheel-domain.test.mjs tests/apple-music-importer.test.mjs tests/pack-import-domain.test.mjs tests/ranked-domain.test.mjs tests/ranked-mode.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern \"Themes inputs\"",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260728.1",
    "@eslint/css": "^1.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.27",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.4",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.0",
      "ws": "8.21.1"
    },
    "minimatch@3.1.5": "10.2.6",
    "next": {
      "postcss": "8.5.23"
    },
    "sharp": "$sharp"
  },
  "type": "module"
}
